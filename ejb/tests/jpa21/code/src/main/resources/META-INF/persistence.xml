<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence version="3.2"
	xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:orm="https://jakarta.ee/xml/ns/persistence/orm"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd
		https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_2.xsd"
>
    <persistence-unit name="org.example.jpa21.model">
        <class>org.example.jpa21.model.Department</class>
        <class>org.example.jpa21.model.Employee</class>
        <class>org.example.jpa21.model.Project</class>
    </persistence-unit>
</persistence>
